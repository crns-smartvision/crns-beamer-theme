\setbeamertemplate{frametitle continuation}{%
  \usebeamerfont{frametitle}
  \romannumeral \insertcontinuationcount
}
\newlength{\crns@progressinheadfoot}
\newlength{\crns@progressinheadfoot@linewidth}
\setlength{\crns@progressinheadfoot@linewidth}{0.8pt}
\setbeamertemplate{progress bar in head/foot}{
  \nointerlineskip
  \setlength{\crns@progressinheadfoot}{%
    \paperwidth * \ratio{\insertframenumber pt}{\inserttotalframenumber pt}%
  }%
  \begin{beamercolorbox}[wd=\paperwidth]{progress bar in head/foot}
    \tikzexternaldisable%
    \begin{tikzpicture}
      \fill[bg] (0,0) rectangle (0.6\paperwidth, \crns@progressinheadfoot@linewidth);
      \fill[fg] (0,0) rectangle (\crns@progressinheadfoot, \crns@progressinheadfoot@linewidth);
    \end{tikzpicture}%
    \tikzexternalenable%
  \end{beamercolorbox}
}
\AtBeginDocument{%
  \apptocmd{\appendix}{%
    \pgfkeys{%
      /crns/outer/.cd,
      numbering=none,
      progressbar=none}
    }{}{}
}
\crns@outer@setdefaults
\ProcessPgfPackageOptions{/crns/outer}
\endinput
