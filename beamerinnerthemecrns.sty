% ABH Define section and subsection font sizes
\newcommand{\CRNSSectionFont}{\fontsize{14pt}{14pt}\selectfont}
\newcommand{\CRNSSubsectionFont}{\fontsize{10pt}{10pt}\selectfont}
\setbeamerfont{section in toc}{size=\large,series=\bfseries}
\setbeamerfont{subsection in toc}{size=\normalsize,series=\mdseries}


\newcommand{\showverticalsubsections}{
  \begin{itemize}
    \foreach \sub in {Education,Sub2,Sub3}{%
      \ifx\sub\insertsubsectionhead
        \item \CRNSSubsectionFont\sub % highlight current subsection
      \else
        \item \textcolor{gray}{\sub} % others in gray
      \fi
    }
  \end{itemize}
}


\pgfkeys{
  /crns/inner/sectionpage/.cd,
    .is choice,
    none/.code=\crns@disablesectionpage,
    simple/.code={\crns@enablesectionpage
                  \setbeamertemplate{section page}[simple]},
    progressbar/.code={\crns@enablesectionpage
                       \setbeamertemplate{section page}[progressbar]},
}
\pgfkeys{
  /crns/inner/subsectionpage/.cd,
    .is choice,
    none/.code=\crns@disablesubsectionpage,
    simple/.code={\crns@enablesubsectionpage
                  \setbeamertemplate{section page}[simple]},
    progressbar/.code={\crns@enablesubsectionpage
                       \setbeamertemplate{section page}[progressbar]},
    progressbarextended/.code={\crns@enablesubsectionpage
                       \setbeamertemplate{subsection page}[progressbarextended]},
}
\newcommand{\crns@inner@setdefaults}{
  \pgfkeys{/crns/inner/.cd,
    sectionpage=progressbar,
    subsectionpage=none
  }
}



\setbeamertemplate{title page}{
  \begin{minipage}[b][\paperheight]{\textwidth}
    %\ifx\inserttitlegraphic\@empty\else\usebeamertemplate*{title graphic}\fi
    \usebeamertemplate*{title graphic}
    \vfill%
    \vspace{2cm}
    \ifx\inserttitle\@empty\else\usebeamertemplate*{title}\fi
    \ifx\insertsubtitle\@empty\else\usebeamertemplate*{subtitle}\fi
    \usebeamertemplate*{title separator}
    \ifx\beamer@shortauthor\@empty\else\usebeamertemplate*{author}\fi
    \ifx\insertdate\@empty\else\usebeamertemplate*{date}\fi
    \ifx\insertinstitute\@empty\else\usebeamertemplate*{institute}\fi
    \vfill
    \vspace*{1mm}
  \end{minipage}
}
\def\maketitle{%
  \ifbeamer@inframe
    \titlepage
  \else
    \frame[plain,noframenumbering]{\titlepage}
  \fi
}
\def\titlepage{%
  \usebeamertemplate{title page}
}
\setbeamertemplate{title graphic}{
  \vbox to 0pt {
  	%ABH removed the vertical space to align with page canvas
    \hspace*{-3.75em}
    \includegraphics[width=\paperwidth, height=\paperheight]{graphics/titlepage_background_v3.pdf}
}
\nointerlineskip%
}

\setbeamertemplate{standout graphics}{
\vbox to 0pt{        \hspace*{-3.75em}        \vspace*{-50em}           
\includegraphics[width=\paperwidth, height=\paperheight]{logos/background_standout.eps} 
}
  \nointerlineskip%
}


\setbeamertemplate{title}{
  \raggedright%
  \linespread{1.0}%
  \inserttitle%
  \par%
  \vspace*{0.5em}
}
\setbeamertemplate{subtitle}{
  \raggedright%
  \insertsubtitle%
  \par%
  \vspace*{0.5em}
}
\newlength{\crns@titleseparator@linewidth}
\setlength{\crns@titleseparator@linewidth}{0.4pt}
\setbeamertemplate{title separator}{
  \tikzexternaldisable%
  \begin{tikzpicture}
    \fill[fg] (0,0) rectangle (0.75\textwidth, \crns@titleseparator@linewidth);
  \end{tikzpicture}%
  \tikzexternalenable%
  \par%
}
\setbeamertemplate{author}{
  \vspace*{2em}
  \insertauthor%
  \par%
  \vspace*{0.25em}
}
\setbeamertemplate{date}{
  \insertdate%
  \par%
}
\setbeamertemplate{institute}{
  \vspace*{3mm}
  \insertinstitute%
  \par%
}
\defbeamertemplate{section page}{simple}{
  \begin{center}
    \usebeamercolor[fg]{section title}
	\CRNSSectionFont
    \insertsectionhead\par
    \ifx\insertsubsectionhead\@empty\else
      \usebeamercolor[fg]{subsection title}
      \usebeamerfont{subsection title}
      \insertsubsectionhead
    \fi
  \end{center}
}
\defbeamertemplate{section page}{progressbar}{
  \centering
  \begin{minipage}{35em}
  	\vspace*{-0.3\textheight} 
    \raggedright
    \usebeamercolor[fg]{section title}
	\CRNSSectionFont
    \insertsectionhead\\[-1ex]
    \usebeamertemplate*{progress bar in section page}
    \par
    \ifx\insertsubsectionhead\@empty\else%
      \usebeamercolor[fg]{subsection title}%
      \usebeamerfont{subsection title}%
      \insertsubsectionhead
    \fi
  \end{minipage}
  \par
  \vspace{\baselineskip}
}


\defbeamertemplate{subsection page}{progressbarextended}{
  \centering
  \begin{minipage}{35em}
%   \vspace*{-0.3\textheight} 
%    \raggedright
%    \usebeamercolor[fg]{section title}
%	\CRNSSectionFont
%    \insertsectionhead\\%[-1ex]

	% Progress bar
    \usebeamertemplate*{progress bar in section page}
\vspace*{10pt}    
    \par 
    \CRNSSubsectionFont
\tableofcontents[
  hideothersubsections,                % only subsections of current section are considered
  sectionstyle=show/shaded,            % current section normal, others dimmed
  subsectionstyle=shaded/hide,         % current subsection shown, others dimmed
  currentsubsection                     % mark current subsection
	]
  \end{minipage}
  \par
  \vspace{\baselineskip}
}

