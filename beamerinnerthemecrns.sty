%% for section page, transition between sections
\newcommand{\crns@disablesectionpage}{
  \AtBeginSection{
    % intentionally empty
  }
}
\newcommand{\crns@enablesectionpage}{
  \AtBeginSection{
    \ifbeamer@inframe
      \sectionpage
    \else
      \frame[plain,c,noframenumbering]{\sectionpage}
    \fi
  }
}
\setbeamertemplate{subsection page}{%
  \usebeamertemplate*{section page}
}
\newcommand{\crns@disablesubsectionpage}{
  \AtBeginSubsection{
    % intentionally empty
  }
}
\newcommand{\crns@enablesubsectionpage}{
  \AtBeginSubsection{
    \ifbeamer@inframe
      \subsectionpage
    \else
      \frame[plain,c,noframenumbering]{\subsectionpage}
    \fi
  }
}
\newlength{\crns@progressonsectionpage}
\newlength{\crns@progressonsectionpage@linewidth}
\setlength{\crns@progressonsectionpage@linewidth}{2pt}
\setbeamertemplate{progress bar in section page}{
  \setlength{\crns@progressonsectionpage}{%
    \textwidth * \ratio{\insertframenumber pt}{\inserttotalframenumber pt}%
  }%
  \tikzexternaldisable%
  \begin{tikzpicture}[yshift=3cm]
    \fill[bg] (0,0) rectangle (\textwidth, \crns@progressonsectionpage@linewidth);
    \fill[fg] (0,0) rectangle (\crns@progressonsectionpage, \crns@progressonsectionpage@linewidth);
  \end{tikzpicture}%
  \tikzexternalenable%
}
\def\inserttotalframenumber{100} % was 100 ABH
\newlength{\crns@blocksep}
\newlength{\crns@blockadjust}
\setlength{\crns@blocksep}{0.75ex}
\setlength{\crns@blockadjust}{0.25ex}
\providecommand{\crns@strut}{%
  \vphantom{ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz()}%
}
%TODO ABH
\newcommand{\crns@block}[1]{
  \par\vskip\medskipamount%
  \setlength{\parskip}{0pt}
  \ifbeamercolorempty[bg]{block title#1}{%
    \begin{beamercolorbox}[rightskip=0pt plus 4em]{block title#1}}{%
  \ifbeamercolorempty[bg]{block title}{%
    \begin{beamercolorbox}[rightskip=0pt plus 4em]{block title#1}%
  }%
  {%
    \begin{beamercolorbox}[
      sep=\dimexpr\crns@blocksep-\crns@blockadjust\relax,
      leftskip=\crns@blockadjust,
      rightskip=\dimexpr\crns@blockadjust plus 4em\relax
    ]{block title#1}%
  }}%
      \usebeamerfont*{block title#1}%
      \crns@strut%
      \insertblocktitle%
      \crns@strut%
  \end{beamercolorbox}%
  \nointerlineskip%
  \ifbeamercolorempty[bg]{block body#1}{%
    \begin{beamercolorbox}[vmode]{block body#1}}{
  \ifbeamercolorempty[bg]{block body}{%
    \begin{beamercolorbox}[vmode]{block body#1}%
  }{%
    \begin{beamercolorbox}[sep=\crns@blocksep, vmode]{block body#1}%
    \vspace{-\crns@parskip}
  }}%
      \usebeamerfont{block body#1}%
      \setlength{\parskip}{\crns@parskip}%
}
\setbeamertemplate{block begin}{\crns@block{}}
\setbeamertemplate{block alerted begin}{\crns@block{ alerted}}
\setbeamertemplate{block example begin}{\crns@block{ example}}
\setbeamertemplate{block end}{\end{beamercolorbox}\vspace*{0.2ex}}
\setbeamertemplate{block alerted end}{\end{beamercolorbox}\vspace*{0.2ex}}
\setbeamertemplate{block example end}{\end{beamercolorbox}\vspace*{0.2ex}}
\setbeamertemplate{itemize items}{\textbullet}
\setbeamertemplate{caption label separator}{: }
\setbeamertemplate{caption}[numbered]
\setbeamertemplate{footnote}{%
  \parindent 0em\noindent%
  \raggedright
  \usebeamercolor{footnote}\hbox to 0.8em{\hfil\insertfootnotemark}\insertfootnotetext\par%
}
\newlength{\crns@parskip}
\setlength{\crns@parskip}{0.5em}
\setlength{\parskip}{\crns@parskip}
\linespread{1.15}
\define@key{beamerframe}{c}[true]{% centered
  \beamer@frametopskip=0pt plus 1fill\relax%
  \beamer@framebottomskip=0pt plus 1fill\relax%
  \beamer@frametopskipautobreak=0pt plus .4\paperheight\relax%
  \beamer@framebottomskipautobreak=0pt plus .6\paperheight\relax%
  \def\beamer@initfirstlineunskip{}%
}
\providebool{crns@standout}
\define@key{beamerframe}{standout}[true]{%
  \booltrue{crns@standout}
  \begingroup
    \setkeys{beamerframe}{c}
    \setkeys{beamerframe}{noframenumbering}
    %\usebeamertemplate{standout graphics}    
    \ifbeamercolorempty[bg]{palette primary}{
      \setbeamercolor{background canvas}{
        use=palette primary,
        bg=palette primary.fg
      }
    }{
      \setbeamercolor{background canvas}{
        use=palette primary,
        bg=palette primary.bg
      }
    }
    \setbeamercolor{local structure}{
      fg=palette primary.fg
      bg=palette primary.bg
    }
    \centering
    \usebeamercolor[bg]{palette primary}
    \usebeamerfont{standout}
}

  \apptocmd{\beamer@reseteecodes}{%
    \ifbool{crns@standout}{
      \endgroup
      \boolfalse{crns@standout}
    }{}
  }{}{}
  
\crns@inner@setdefaults
\ProcessPgfPackageOptions{/crns/inner}
